<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }}{% else %}JP Consultancy - Healthcare Design &amp; Equipment Strategists{% endif %}</title>
    <meta name="description" content="{% if description %}{{ description }}{% else %}Your trusted partner in hospital design, planning, and equipment management for unparalleled operational efficiency.{% endif %}">
    
    <!-- SEO Meta Tags -->
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
    <meta name="robots" content="index, follow">
    <meta name="author" content="JP Consultancy">
    <link rel="canonical" href="https://www.jpconsultancy.in{{ page.url }}">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}JP Consultancy - Healthcare Design &amp; Equipment Strategists{% endif %}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}Your trusted partner in hospital design, planning, and equipment management for unparalleled operational efficiency.{% endif %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.jpconsultancy.in{{ page.url }}">
    <meta property="og:image" content="https://www.jpconsultancy.in/assets/images/og-image.jpg">
    <meta property="og:site_name" content="JP Consultancy">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}JP Consultancy - Healthcare Design &amp; Equipment Strategists{% endif %}">
    <meta name="twitter:description" content="{% if description %}{{ description }}{% else %}Your trusted partner in hospital design, planning, and equipment management for unparalleled operational efficiency.{% endif %}">
    <meta name="twitter:image" content="https://www.jpconsultancy.in/assets/images/og-image.jpg">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/icons/JP CONSULTANCY SVG.svg">
    
    <!-- CSS with cache-busting query string -->
    <link rel="stylesheet" href="/assets/css/main.css?v=130.0.0">
    <style>
      /* Force-mobile preview (only when body has .force-mobile) */
      body.force-mobile .mobile-menu-toggle { display: flex !important; }
      body.force-mobile .nav-menu { display: none !important; }
      body.force-mobile .nav-menu.active { display: flex !important; }
    </style>
    
    <!-- AOS Animation Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Contact Ribbon -->
    <div class="contact-ribbon">
      <div class="container contact-ribbon-inner">
        <span><strong>Phone:</strong> <a href="tel:+919819945543">+91 9819945543</a></span>
        <span class="ribbon-sep">|</span>
        <span><strong>Email:</strong> <a href="mailto:Info.jpconsultant@gmail.com">Info.jpconsultant@gmail.com</a></span>
      </div>
    </div>
    <!-- Navigation -->
    <div class="navbar">
        <div class="container">
            <a href="/" class="nav-brand">
                <img src="/assets/icons/JP CONSULTANCY SVG.svg" alt="JP Consultancy Logo" class="logo"/>
            </a>
            
            <div class="nav-menu" id="nav-menu">
                <a href="/" class="nav-link {% if page.url == '/' %}active{% endif %}">Home</a>
                <div class="nav-dropdown" style="position:relative;">
                    <a href="#" class="nav-link {% if '/service-details/' in page.url %}active{% endif %}">Services</a>
                    <div class="dropdown-content simple-dropdown">
                        <a href="/service-details/hospital-planning">Hospital Planning & Design</a>
                        <a href="/service-details/equipment">Hospital Equipment Planning</a>
                        <a href="/service-details/quality">Quality and Accreditation</a>
                        <a href="/service-details/training">Health Training</a>
                        <a href="/service-details/operations">Hospital Operations</a>
                        <a href="/service-details/tourism">Medical Tourism</a>
                    </div>
                </div>
                <a href="/projects/" class="nav-link {% if '/projects' in page.url %}active{% endif %}">Projects</a>
                <a href="/about" class="nav-link {% if '/about' in page.url %}active{% endif %}">About</a>
                <a href="/contact" class="nav-link {% if '/contact' in page.url %}active{% endif %}">Contact</a>
            </div>
            
            <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-label="Open menu" aria-controls="nav-menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <main>
        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <div class="footer-brand">
                        <img src="/assets/icons/JP CONSULTANCY SVG.svg" alt="JP Consultancy" class="footer-logo">
                        <p>Your partners in organizational transformation journey. We don't provide expert solutions. We help you 
                find them.</p>
                    </div>
                </div>
                
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/projects/">Projects</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h3>Services</h3>
                    <ul class="footer-links">
                        <li><a href="/service-details/hospital-planning">Hospital Planning & Design</a></li>
                        <li><a href="/service-details/equipment">Hospital Equipment Planning</a></li>
                        <li><a href="/service-details/quality">Quality and Accreditation</a></li>
                        <li><a href="/service-details/training">Health Training</a></li>
                        <li><a href="/service-details/operations">Hospital Operations</a></li>
                        <li><a href="/service-details/tourism">Medical Tourism</a></li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h3>Contact Info</h3>
                    <div class="contact-info">
                        <p><strong>Phone:</strong> +91 9819945543</p>
                        <p><strong>Email:</strong> Info.jpconsultant@gmail.com</p>
                        <p><strong>Address:</strong> 1st Floor, Jayraj Bhuvan, New Mill Road, Kurla West, Mumbai – 400070</p>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>&copy; <script>document.write(new Date().getFullYear())</script> JP Consultancy. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <!-- Mobile Navigation Script (force-mobile only; handlers in script.js) -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            try {
              const params = new URLSearchParams(window.location.search);
              if (params.get('m') === '1') {
                document.body.classList.add('force-mobile');
              }
            } catch (e) {}
        });
    </script>
    <script src="/assets/js/script.js"></script>
    
    <!-- Mobile Services Submenu Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
            const navMenu = document.getElementById('nav-menu');
            const servicesDropdown = document.querySelector('.nav-dropdown');
            const servicesLink = servicesDropdown ? servicesDropdown.querySelector('.nav-link') : null;
            
            // Mobile menu toggle
            if (mobileMenuToggle && navMenu) {
                mobileMenuToggle.addEventListener('click', function() {
                    navMenu.classList.toggle('active');
                    mobileMenuToggle.classList.toggle('active');
                });
            }
            
            // Services submenu toggle for mobile ONLY
            if (servicesLink && servicesDropdown) {
                servicesLink.addEventListener('click', function(e) {
                    // Check if we're on mobile and menu is active
                    if (window.innerWidth <= 768 && navMenu && navMenu.classList.contains('active')) {
                        e.preventDefault();
                        e.stopPropagation();
                        servicesDropdown.classList.toggle('active');
                    }
                });
            }
            
            // Close menu when clicking outside
            document.addEventListener('click', function(e) {
                if (navMenu && navMenu.classList.contains('active')) {
                    if (!e.target.closest('.nav-menu') && !e.target.closest('.mobile-menu-toggle')) {
                        navMenu.classList.remove('active');
                        mobileMenuToggle.classList.remove('active');
                        if (servicesDropdown) servicesDropdown.classList.remove('active');
                    }
                }
            });
        });
    </script>
    
    <!-- Initialize AOS -->
    <script>
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });
    </script>
</body>
</html> 