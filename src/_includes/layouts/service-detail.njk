{% extends "layouts/base.njk" %}

{% block content %}
<div class="service-detail">
        
        <!-- Page Hero Section -->
        <section class="service-hero" style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('{{ hero.background }}') !important; min-height: 75vh !important; background-size: cover !important; background-position: center !important; display: flex !important; align-items: center !important; justify-content: center !important; padding: 5rem 0 !important;">
            <div class="container">
                <div class="service-hero-content" style="position: relative !important; z-index: 3 !important; max-width: 1200px !important; margin: 0 auto !important; padding: 0 2rem !important; text-align: center !important;">
                    <h1 style="font-size: 4rem !important; font-weight: 700 !important; color: white !important; margin-bottom: 2rem !important; text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3) !important;">{{ hero.title }}</h1>
                    <p style="font-size: 1.3rem !important; font-weight: 400 !important; color: rgba(255, 255, 255, 0.95) !important; margin-bottom: 0 !important; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2) !important;">{{ hero.subtitle }}</p>
                </div>
            </div>
        </section>

        <!-- Why Choose Section -->
        {% if why_choose %}
        <section class="why-choose-section" style="background: linear-gradient(rgba(255,255,255,0.88), rgba(255,255,255,0.88)), url('/assets/images/grid-service3.jpg') !important; background-size: cover !important; background-position: center !important; background-attachment: fixed !important; padding: 2rem 0 !important; display: block !important; margin: 1rem 0 !important;">
            <div class="container">
                <div class="section-header">
                    <h2 style="color: #0f172a !important; font-size: 2.5rem !important; font-weight: 700 !important; text-align: center !important; margin-bottom: 0.3rem !important; display: inline-block !important; padding: 0.4rem 0.9rem !important; border-radius: 12px !important; background: rgba(255,255,255,0.7) !important; backdrop-filter: blur(6px) !important; -webkit-backdrop-filter: blur(6px) !important; box-shadow: 0 6px 24px rgba(0,0,0,0.18) !important;">{{ why_choose.title }}</h2>
                    <p style="color: #0f172a !important; font-size: 1.2rem !important; text-align: center !important; margin-bottom: 0.5rem !important; display: inline-block !important; padding: 0.25rem 0.8rem !important; border-radius: 9999px !important; background: rgba(255,255,255,0.7) !important; backdrop-filter: blur(6px) !important; -webkit-backdrop-filter: blur(6px) !important; box-shadow: 0 6px 20px rgba(0,0,0,0.16) !important;">Expert Solutions for Healthcare Excellence</p>
                </div>
                <div class="why-choose-grid-mobile" style="background: #f8fafc !important; display: grid !important; grid-template-columns: repeat(4, 1fr) !important; gap: 0.6rem !important; margin-top: 0.2rem !important; padding: 0.4rem !important; border-radius: 16px !important; box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;" data-mobile-grid="2x2">
                    {% for point in why_choose.points %}
                    <div style="background: linear-gradient(135deg, #ffffff 0%, #f8faff 100%) !important; padding: 2.5rem 1.8rem !important; border: 1px solid #e2e8f0 !important; display: block !important; min-height: 200px !important; border-radius: 12px !important; box-shadow: 0 4px 15px rgba(31,95,255,0.06) !important; transition: all 0.3s ease !important; position: relative !important; overflow: hidden !important;">
                        <!-- Top accent line -->
                        <div style="position: absolute !important; top: 0 !important; left: 0 !important; right: 0 !important; height: 3px !important; background: linear-gradient(90deg, #3b82f6, #8b5cf6) !important;"></div>
                        
                        <!-- Larger tick icon without circle background -->
                        <div style="display: flex !important; align-items: center !important; justify-content: center !important; margin: 0 auto 0.8rem auto !important; width: 50px !important; height: 50px !important;">
                            <img src="/assets/icons/service-icon.svg" alt="{{ point.title }} Icon" style="width: 40px !important; height: 40px !important;">
                        </div>
                        
                        <h3 style="color: #1e293b !important; font-size: 1.1rem !important; font-weight: 700 !important; margin-bottom: 0.6rem !important; text-align: center !important; line-height: 1.3 !important;">{{ point.title }}</h3>
                        <p style="color: #64748b !important; font-size: 0.9rem !important; text-align: center !important; line-height: 1.4 !important; margin: 0 !important;">{{ point.description }}</p>
                        
                        <!-- Bottom accent dot -->
                        <div style="position: absolute !important; bottom: 0.6rem !important; left: 50% !important; transform: translateX(-50%) !important; width: 6px !important; height: 6px !important; background: #3b82f6 !important; border-radius: 50% !important;"></div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- Core Services Section -->
        {% if core_services %}
        <section class="core-services-section" {% if core_services.background %}style="background-image: linear-gradient(rgba(255,255,255,0.95), rgba(255,255,255,0.95)), url('{{ core_services.background }}')"{% endif %}>
            <div class="container">
                <div class="section-header fade-in-up">
                    <h2>{{ core_services.title }}</h2>
                    <p style="color: white !important;">Comprehensive Healthcare Solutions</p>
                </div>
                
                <!-- Core Services Matrix Grid (symmetrical rows of 3) -->
                <div class="core-services-matrix">
                    {% set services = core_services.services %}
                    {% for i in range(0, services | length, 3) %}
                        {% set a = services[i] %}
                        {% set b = services[i + 1] if (i + 1) < (services | length) %}
                        {% set c = services[i + 2] if (i + 2) < (services | length) %}

                        {% set textCount = 0 %}
                        {% if a is defined and a.type == 'text' %}{% set textCount = textCount + 1 %}{% endif %}
                        {% if b is defined and b.type == 'text' %}{% set textCount = textCount + 1 %}{% endif %}
                        {% if c is defined and c.type == 'text' %}{% set textCount = textCount + 1 %}{% endif %}

                        {% macro render_item(item, idx) %}
                            <div class="matrix-item matrix-{{ item.type }} {% if item.type == 'text' %}fade-in-left{% else %}fade-in-right{% endif %} animate-delay-{{ idx }}00">
                                {% if item.type == 'text' %}
                                <div class="service-card">
                                    <h3>{{ item.title }}</h3>
                                    <p>{{ item.description }}</p>
                                </div>
                                {% else %}
                                <div class="service-image">
                                    <img src="{{ item.image }}" alt="{{ item.alt }}" loading="lazy">
                                </div>
                                {% endif %}
                            </div>
                        {% endmacro %}

                        {% if textCount == 1 %}
                            {# Pattern: Image | Text | Image #}
                            {# find the single text item and ensure it is rendered in the middle #}
                            {% set textItem = a if a is defined and a.type == 'text' else (b if b is defined and b.type == 'text' else c) %}
                            {% set img1 = a if a is defined and a.type == 'image' else (b if b is defined and b.type == 'image' else c) %}
                            {% set img2 = (c if c is defined and c.type == 'image' else (b if b is defined and b.type == 'image' and b != img1 else (a if a is defined and a.type == 'image' and a != img1 else undefined))) %}

                            {% if img1 is defined %}{{ render_item(img1, i + 1) }}{% endif %}
                            {% if textItem is defined %}{{ render_item(textItem, i + 2) }}{% endif %}
                            {% if img2 is defined %}{{ render_item(img2, i + 3) }}{% endif %}

                        {% elif textCount == 2 %}
                            {# Pattern: Text | Image | Text #}
                            {% set imgItem = a if a is defined and a.type == 'image' else (b if b is defined and b.type == 'image' else c) %}
                            {% set t1 = a if a is defined and a.type == 'text' else (b if b is defined and b.type == 'text' else c) %}
                            {% set t2 = (c if c is defined and c.type == 'text' and c != t1 else (b if b is defined and b.type == 'text' and b != t1 else (a if a is defined and a.type == 'text' and a != t1 else undefined))) %}

                            {% if t1 is defined %}{{ render_item(t1, i + 1) }}{% endif %}
                            {% if imgItem is defined %}{{ render_item(imgItem, i + 2) }}{% endif %}
                            {% if t2 is defined %}{{ render_item(t2, i + 3) }}{% endif %}

                        {% else %}
                            {# Default: render in given order #}
                            {% if a is defined %}{{ render_item(a, i + 1) }}{% endif %}
                            {% if b is defined %}{{ render_item(b, i + 2) }}{% endif %}
                            {% if c is defined %}{{ render_item(c, i + 3) }}{% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- Approach Section -->
        {% if approach %}
        <section class="approach-section" {% if approach_background %}style="background-image: linear-gradient(rgba(255,255,255,0.92), rgba(255,255,255,0.92)), url('{{ approach_background }}')"{% endif %}>
            <div class="container">
                <div class="section-header fade-in-up">
                    <h2>{{ approach.title }}</h2>
                    <p>{{ approach.content }}</p>
                </div>
                <div class="approach-methodology-text" style="text-align:left; margin-bottom: 2rem;">
                    Our planning methodology is rooted in industry best practices and tailored to the unique needs of each client. This ensures smooth patient movement, improved infection control, and reduced operational inefficiencies.
                </div>
                {% if approach.timeline %}
                <div class="approach-timeline">
                    {% for step in approach.steps %}
                    <div class="timeline-item">
                        <div class="timeline-number">{{ step.number }}</div>
                        <div class="timeline-content">
                            <h3>{{ step.title }}</h3>
                            <p>{{ step.description }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </section>
        {% endif %}

        <!-- Deliverables Section -->
        {% if deliverables %}
        <section class="deliverables-section">
            <div class="container">
                <div class="section-header fade-in-up">
                    <h2>{{ deliverables.title }}</h2>
                    <p style="color: white;">Complete Project Deliverables</p>
                </div>
                <div class="deliverables-scroll">
                    {% for item in deliverables.items %}
                    <div class="deliverable-card scale-in animate-delay-{{ loop.index }}00">
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.description }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- Methodology Statement (remove blue bubble) -->
        {% if methodology %}
        <section class="methodology-section">
            <div class="container">
                <p class="methodology-text">{{ methodology }}</p>
            </div>
        </section>
        {% endif %}

        <!-- CTA Section -->
        {% if cta %}
        <section class="service-cta-section">
            <div class="container">
                <div class="cta-content fade-in-up">
                    <div class="cta-background">
                        <div class="cta-overlay"></div>
                    </div>
                    <div class="cta-text">
                        <h2>{{ cta.title }}</h2>
                        <p>{{ cta.subtitle }}</p>
                        <div class="cta-buttons">
                            {% for button in cta.buttons %}
                            <a href="{{ button.link }}" class="btn btn-{{ button.style }}">{{ button.text }}</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </section>
        {% endif %}

</div>

<!-- JavaScript Solution for Mobile 2x2 Grid -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    function updateGrid() {
        const grid = document.querySelector('[data-mobile-grid="2x2"]');
        if (grid) {
            if (window.innerWidth <= 768) {
                // Mobile: 2x2 layout
                grid.style.setProperty('grid-template-columns', 'repeat(2, 1fr)', 'important');
                grid.style.setProperty('grid-template-rows', 'auto auto', 'important');
                grid.style.setProperty('gap', '0.5rem', 'important');
                grid.style.setProperty('padding', '0.3rem', 'important');
                
                // Update card styles for mobile
                const cards = grid.querySelectorAll('> div');
                cards.forEach(card => {
                    card.style.setProperty('padding', '1.5rem 1rem', 'important');
                    card.style.setProperty('min-height', '180px', 'important');
                    card.style.setProperty('font-size', '0.8rem', 'important');
                    
                    const h3 = card.querySelector('h3');
                    if (h3) {
                        h3.style.setProperty('font-size', '0.95rem', 'important');
                        h3.style.setProperty('margin-bottom', '0.4rem', 'important');
                    }
                });
            } else {
                // Desktop: 4x1 layout
                grid.style.setProperty('grid-template-columns', 'repeat(4, 1fr)', 'important');
                grid.style.setProperty('grid-template-rows', 'auto', 'important');
                grid.style.setProperty('gap', '0.6rem', 'important');
                grid.style.setProperty('padding', '0.4rem', 'important');
                
                // Reset card styles for desktop
                const cards = grid.querySelectorAll('> div');
                cards.forEach(card => {
                    card.style.setProperty('padding', '2.5rem 1.8rem', 'important');
                    card.style.setProperty('min-height', '200px', 'important');
                    card.style.removeProperty('font-size');
                    
                    const h3 = card.querySelector('h3');
                    if (h3) {
                        h3.style.removeProperty('font-size');
                        h3.style.removeProperty('margin-bottom');
                    }
                });
            }
        }
    }

    // Initial call
    updateGrid();
    
    // Update on window resize
    window.addEventListener('resize', updateGrid);
});
</script>
{% endblock %} 